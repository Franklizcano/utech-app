NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TTL de la caché de órdenes en segundos. Si se omite o es inválido, usa 60.
NEXT_PUBLIC_ORDERS_CACHE_TTL_SECONDS=60

# Solo servidor. No usar el prefijo NEXT_PUBLIC_ ni exponer en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto aleatorio largo para firmar el cookie httpOnly `session`.
SESSION_SECRET=

